<Window	x:Class="AabSemantics.Extensions.WPF.Dialogs.ProcessingDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:localization="clr-namespace:AabSemantics.Extensions.WPF.Localization"
		SizeToContent="Height" Width="320" MinWidth="320" ResizeMode="NoResize" ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner" Loaded="dialogLoaded" Closing="dialogClosing">
	<Window.Resources>
		<ObjectDataProvider x:Key="language" ObjectType="{x:Type localization:Localizator}" />
	</Window.Resources>
	<StackPanel Margin="10" Orientation="Vertical">
		<TextBlock Margin="2" Name="textBlockCaption" TextWrapping="Wrap" />
		<ProgressBar Margin="2,10,2,10" Height="16" IsIndeterminate="True" />
		<Button Margin="2" Padding="10,3,10,3" HorizontalAlignment="Center" Name="buttonCancel" Click="cancelClick"
				Content="{Binding Source={StaticResource language}, Path=Common.Cancel, Mode=OneTime}" />
	</StackPanel>
</Window>
